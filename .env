# ===== Режим работы =====
# yandex - Yandex Cloud: YandexGPT + SpeechKit, оплата в рублях российской картой (по умолчанию)
# local  - бесплатно и локально: Ollama + faster-whisper/браузер, озвучка в браузере
# openai - OpenAI API (нужен OPENAI_API_KEY)
PROVIDER=yandex

# ===== Yandex Cloud =====
# API-ключ сервисного аккаунта и идентификатор каталога (как получить - README, раздел «Ключи Yandex Cloud»)
YANDEX_API_KEY=AQVN29BwIgdk7n8pwzowXoRcIH_qIROVAldxdxoI
YANDEX_FOLDER_ID=b1g74jrqud4auqt30r04
# Вместо ключа можно указать IAM-токен (живет до 12 часов), обычно не нужно
# YANDEX_IAM_TOKEN=
# Модель: yandexgpt-5.1 (YandexGPT Pro 5.1, по умолчанию) или дешевле - aliceai-llm-flash
YANDEX_GPT_MODEL=yandexgpt-5.1
YANDEX_TEMPERATURE=0.1
YANDEX_LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# Эмбеддинги: записи - text-search-doc, поисковые запросы - text-search-query
YANDEX_EMBED_DOC_MODEL=text-search-doc/latest
YANDEX_EMBED_QUERY_MODEL=text-search-query/latest
# Не больше N запросов эмбеддингов в секунду (квота API - 10)
YANDEX_EMBED_RPS=8
# Голос SpeechKit (API v1): filipp, ermil, zahar, madi_ru (мужские); jane, omazh, marina (женские)
YANDEX_TTS_VOICE=filipp
YANDEX_TTS_SPEED=1.0

# ===== Локальная модель (Ollama), для PROVIDER=local =====
LLM_BASE_URL=http://localhost:11434/v1
# qwen2.5:7b - рекомендуется (16 ГБ ОЗУ); qwen2.5:3b - для слабых машин (8 ГБ ОЗУ)
LLM_MODEL=qwen2.5:7b
# auto - сначала tools, если модель их не умеет - JSON-режим; можно принудительно: tools или json
LLM_TOOLS_MODE=auto
LLM_TEMPERATURE=0
# Эмбеддинги для поиска по смыслу (мультиязычная модель, хорошо понимает русский)
EMBED_MODEL=bge-m3
EMBED_BATCH_SIZE=32
# Порог сходства для поиска (по умолчанию 0.35 для Yandex, 0.45 для bge-m3, 0.3 для OpenAI)
# SEARCH_MIN_SCORE=0.45

# ===== Речь =====
# Распознавание: auto (по провайдеру), yandex (SpeechKit), local (faster-whisper), openai, browser (только в браузере)
STT_ENGINE=auto
# Модель faster-whisper: tiny, base, small, medium, large-v3 (больше - точнее и медленнее)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=ru
# Озвучка: auto (по провайдеру), yandex (SpeechKit), browser (бесплатно, в браузере), openai
TTS_ENGINE=auto

# ===== OpenAI (необязательно) =====
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://example.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_EMBED_MODEL=text-embedding-3-small

# ===== Приложение =====
# Часовой пояс пользователя, от него считаются «завтра», «через час» и т.п.
APP_TIMEZONE=Europe/Moscow
DB_PATH=data/assistant.db
# Пользователь по умолчанию и автоматический импорт истории прошлых запросов при запуске
DEFAULT_USER=Основной
IMPORT_CSV_ON_START=true
HISTORY_CSV=data/voice_assistant_events_1000_77e927b5d2.csv
MEETING_DEFAULT_MINUTES=60
# Сколько последних реплик диалога передавать модели
HISTORY_MESSAGES=10
HOST=127.0.0.1
PORT=8000
